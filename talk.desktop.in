[Desktop Entry]
Type=Application
Name=talk — ditado por voz
Comment=Liga e desliga o daemon de ditado (clique alterna)
Exec=@BIN@ toggle
Icon=audio-input-microphone
Terminal=false
Categories=Utility;
Keywords=ditado;voz;dictation;whisper;talk;
Actions=Ligar;Desligar;Estado;

[Desktop Action Ligar]
Name=Ligar
Exec=@BIN@ on

[Desktop Action Desligar]
Name=Desligar
Exec=@BIN@ off

[Desktop Action Estado]
Name=Ver estado
Exec=@BIN@ status
